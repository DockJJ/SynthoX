# Application Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://synthox_user:synthox_secure_pass@localhost:5432/synthox_db?schema=public

# Cache & Message Broker (Redis for presence and Socket.IO scaling)
REDIS_URL=redis://localhost:6379

# Authentication (JWT Tokens)
# Note: In production, generate strong 256-bit secrets (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=synthox_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=synthox_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# WebRTC STUN/TURN (coturn shared-secret REST API)
TURN_SECRET=synthox_coturn_shared_secret_key_change_in_production
TURN_REALM=synthox.local
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_TTL_SECONDS=86400
